{
  "name": "minspec-monorepo",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "pretest": "node scripts/check-node-modules-integrity.mjs && npm run build --workspace=@aiclarity/shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build": "npm run build --workspaces --if-present",
    "package": "npm run package --workspaces --if-present",
    "validate": "npx tsx scripts/validate-frontmatter.ts",
    "check:cycles": "npx tsx scripts/check-import-cycles.ts",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/minspec/tsconfig.json",
    "check:gh-bot": "bash scripts/check-gh-bot-attribution.sh",
    "facts": "npx tsx scripts/facts.ts",
    "validate:classifier": "vitest run classifier-validation"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@vscode/test-cli": "0.0.11",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "mocha": "11.3.0",
    "picomatch": "^4.0.4",
    "tsx": "4.23.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
