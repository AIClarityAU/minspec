#!/usr/bin/env bash
# pre-push — refuse a push that would be rejected server-side for touching CI
# workflows with a GitHub App credential (#1120).
#
# WHY A HOOK AND NOT ONLY SCRIPT CALL SITES. The scripted publish paths
# (dispatch-issue.sh, remediate-pr.sh) get an explicit preflight, but the case
# that actually bit — `MinSpec: Refresh Harness Files` rewriting five managed
# workflow templates, then a human or agent pushing that by hand — involves no
# script at all. Only a hook covers it.
#
# Sibling of the protected-branch guard in .githooks/pre-commit, written for the
# same reason: the server's refusal arrives after the work is already sealed into
# branch history, so the check has to happen locally and early.
#
# FAILS OPEN by design. If the credential is not an App token, if no workflow
# file is touched, or if anything about the range cannot be determined, the push
# proceeds. This guard exists to turn a cryptic server rejection into an
# actionable message — never to become a new obstacle.
#
# Installed via core.hooksPath=.githooks (set by `npm install` → prepare).
# Bypass: MINSPEC_ALLOW_WORKFLOW_PUSH=1 git push … / git config minspec.allowWorkflowPush true

set -uo pipefail

hook_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
lib="$hook_dir/../scripts/lib/workflow-paths.sh"

# A repo that has the hook but not the lib (partial checkout, older branch)
# must not be blocked from pushing.
[ -f "$lib" ] || exit 0
# shellcheck source=/dev/null
. "$lib"

workflow_push_allowed && exit 0

# git hands pre-push the target as $1 (remote name) and $2 (resolved URL). Forward
# it: without this the probe always keyed on `origin`, so `git push upstream …` or a
# bare-URL push was judged by a remote it was not going to use. $2 is preferred
# because git has already resolved it; $1 is the fallback, and `origin` the last one.
push_credential_is_app_token "${2:-${1:-origin}}" || exit 0

# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>
zero='0000000000000000000000000000000000000000'
touched=''

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  [ "$local_sha" = "$zero" ] && continue          # branch deletion

  # Mirror what the SERVER evaluates: the ref-update range when there is one, the
  # merge-base against the default branch when there is not (#1263). Getting here took
  # three tries, and each wrong turn is worth naming because each was a FALSE REFUSAL —
  # the direction this hook's header explicitly forbids ("never to become a new obstacle").
  #
  #   1. `$base..$local_sha` (two dots). `git diff A..B` is the two-endpoint diff
  #      `git diff A B`, so every path where the BASE moved ahead was reported as changed
  #      by this push. Any stale branch was refused as soon as main had touched
  #      .github/workflows/** since the branch was cut.
  #
  #   2. `$remote_sha...$local_sha` for an existing branch. After a rebase the old remote
  #      tip sits on an ABANDONED history predating main's workflow edits, so the
  #      merge-base is older than main and the workflow file reappears. Three dots does not
  #      rescue a base on a discarded line — measured, not assumed.
  #
  #   3. `$base...$local_sha` for EVERY case. Correct for new and rebased branches, but it
  #      re-flags a workflow edit that is ALREADY on the remote, so an ordinary incremental
  #      push to such a branch is refused for a file it did not change.
  #
  # The server judges a ref update by the commits the update actually adds. So: when
  # `remote_sha` is a real ancestor of `local_sha` this is a fast-forward and that range IS
  # the answer (two dots are correct precisely because it is an ancestor). Otherwise — new
  # branch, or a force-push onto a diverged line — fall back to the merge-base against the
  # default branch, which is what the remote already has.
  base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || base=''
  [ -n "$base" ] || base='origin/main'
  if [ "$remote_sha" != "$zero" ] && git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    range="$base...$local_sha"
  fi

  files=$(git diff --name-only "$range" 2>/dev/null) || continue
  [ -n "$files" ] || continue
  hits=$(printf '%s\n' "$files" | grep -E "$WORKFLOW_PATH_RE" || true)
  [ -n "$hits" ] && touched="${touched}${hits}"$'\n'
done

[ -n "$touched" ] || exit 0

# A workflow file IS touched and the credential IS an App token — the only situation
# where the probe earns its cost. Placed HERE, after detection, so an ordinary push
# never makes a network call (the review on #1460 caught the earlier placement, where
# the comment claimed this and the code did the opposite).
#
# The credential mattering depends on whether the installation actually lacks
# `workflows: write`. It no longer does (#1120), so ask rather than assume. Fails
# CLOSED: an unanswerable probe leaves the refusal exactly as it was.
workflow_permission_granted && exit 0

printf '%s' "$touched" | grep -v '^$' | sort -u | workflow_push_refusal
exit 1
