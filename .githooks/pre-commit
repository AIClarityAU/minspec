#!/usr/bin/env bash
#
# Pre-commit gate (DR-029 RCDD hardening).
#
# A NEWLY-ADDED Decision Register file must be born `status: proposed`.
# Acceptance is a separate, human act ("MinSpec: Accept ADR" → a later status
# flip, a *Modify* commit). A DR therefore cannot be *created* already claiming
# `accepted` / `deprecated` / `superseded` — that is a self-conferred terminal
# status with nothing behind it (the exact false-status defect DR-029 addresses,
# and the asymmetry sibling of issue #112 for specs).
#
# Only fires on git-ADD of a DR file; promoting proposed→accepted later is a
# Modify and is untouched.
#
# Bypass (rare retroactive record of an already-decided DR):
#   ADR_BORN_GATE_OFF=1 git commit ...
#
# Scoped to JUST this DR-029 block (issue #1040) — it must disable only the
# born-status check it names, never fall through as a whole-hook `exit 0`.
# That used to also skip the unrelated committable-symlink gate (#913) and the
# validate gate below, so the documented merge-commit workaround for THIS gate
# silently disabled two gates it has nothing to do with — a silent gate,
# which invariant 2 (constitution) forbids.
set -euo pipefail

# ── protected-branch guard ───────────────────────────────────────────────────
# Twin of the Stage 0 guard in the generated hook template
# (packages/minspec/src/lib/template-registry.ts). This repo sets
# core.hooksPath=.githooks, so the generated .minspec/hooks/pre-commit never
# runs here — without this copy, the repo that SHIPS the guard would be the one
# repo not protected by it. The two must not drift; a test asserts they carry
# the same decisive lines.
#
# Why it exists: `main` is ruleset-gated on pull-request-only checks, so a
# commit authored here can never be pushed. Without this the rejection arrives
# at `git push`, after the work is already sealed into branch history.
#
# Kept FIRST so no other gate's bypass can disable it. That mattered acutely
# before #1043, when ADR_BORN_GATE_OFF was a whole-hook `exit 0` set routinely
# for merge commits; #1043 scoped every bypass to its own block, so ordering is
# no longer load-bearing for correctness. It stays first as defence in depth,
# and a test asserts no whole-hook `exit 0` is ever reintroduced above it.
minspec_branch_guard() {
  if [ "${MINSPEC_ALLOW_MAIN:-0}" = "1" ]; then return 0; fi
  if [ "$(git config --get minspec.allowCommitOnDefaultBranch 2>/dev/null)" = "true" ]; then return 0; fi

  guard_git_dir=$(git rev-parse --git-dir 2>/dev/null) || return 0
  if [ -z "${guard_git_dir:-}" ]; then return 0; fi

  for guard_marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    if [ -e "$guard_git_dir/$guard_marker" ]; then return 0; fi
  done
  if [ -d "$guard_git_dir/rebase-merge" ]; then return 0; fi
  if [ -d "$guard_git_dir/rebase-apply" ]; then return 0; fi

  guard_current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) || return 0
  if [ -z "${guard_current:-}" ]; then return 0; fi

  guard_default=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')

  # origin/HEAD is the precise answer but is NOT always populated — it is absent
  # in both repos this guard was written for, which made the guard silently
  # inert exactly where it was needed. `git remote set-head origin <branch>`
  # repairs it, but the gate must not depend on someone having done that.
  #
  # Fall back to conventional protected names. Still not a hardcoded "main":
  # only these names are treated as protected, any other branch is untouched,
  # and the list is configurable per project.
  #
  # Gated on an `origin` remote existing. A repo with no remote has nothing to
  # push to, so no branch in it can be push-protected and committing on `main`
  # is entirely correct — scratch repos, fixtures and local-only projects must
  # never be blocked.
  if [ -z "${guard_default:-}" ] && git config --get remote.origin.url >/dev/null 2>&1; then
    guard_candidates=$(git config --get minspec.protectedBranches 2>/dev/null || true)
    if [ -z "${guard_candidates:-}" ]; then guard_candidates="main master trunk"; fi
    for guard_name in $guard_candidates; do
      if [ "$guard_current" = "$guard_name" ]; then
        guard_default="$guard_name"
        break
      fi
    done
  fi

  if [ -z "${guard_default:-}" ]; then return 0; fi

  if [ "$guard_current" != "$guard_default" ]; then return 0; fi

  echo "✗ MinSpec gate: refusing to commit on '$guard_current' — this project's default branch." >&2
  echo "  It is push-protected (pull-request-only checks), so this commit could not be" >&2
  echo "  pushed and would strand the work in local history." >&2
  echo "" >&2
  echo "  Move the staged work onto a branch and commit there:" >&2
  echo "      git switch -c <branch-name>" >&2
  echo "      git commit ..." >&2
  echo "" >&2
  echo "  Already committed on $guard_current? Keep the work, then rewind the branch:" >&2
  echo "      git branch <branch-name>" >&2
  echo "      git reset --hard origin/$guard_default" >&2
  echo "" >&2
  echo "  Allow once:      MINSPEC_ALLOW_MAIN=1 git commit ..." >&2
  echo "  Allow in future: git config minspec.allowCommitOnDefaultBranch true" >&2
  return 1
}

if ! minspec_branch_guard; then
  exit 1
fi

fail=0
if [ "${ADR_BORN_GATE_OFF:-}" != "1" ]; then
  while IFS=$'\t' read -r _status path; do
    case "$path" in
      docs/decisions/DR-*.md) ;;
      *) continue ;;
    esac
    born=$(git show ":$path" | grep -m1 -E '^status:' | sed -E 's/^status:[[:space:]]*//; s/[[:space:]]*#.*//; s/[[:space:]]*$//')
    if [ "$born" != "proposed" ] && [ "$born" != "draft" ]; then
      echo "✖ DR-029 gate: new DR '$path' is born 'status: ${born:-<none>}' — must be 'proposed'." >&2
      echo "  Acceptance is a separate human act (MinSpec: Accept ADR). Create proposed; accept after review." >&2
      echo "  Override (rare retroactive record): ADR_BORN_GATE_OFF=1 git commit ..." >&2
      fail=1
    fi
  done < <(git diff --cached --name-status --diff-filter=A)
fi

# ── committable-symlink gate (#913 / bit #900) ───────────────────────────────
# `.gitignore`'s `node_modules/` pattern matches a DIRECTORY, not a symlink FILE
# named `node_modules`, so `git add` happily accepts a symlink. Build/test
# worktrees routinely `ln -s <primary>/node_modules` to share hoisted deps; if
# one is staged before removal it commits an ABSOLUTE dev-machine path that
# breaks every other checkout and CI (the exact defect in PR #900).
#
# Reject a staged symlink (git mode 120000) when ANY of:
#   • its own name is `node_modules` (at any depth) — shared hoisted deps are
#     machine-local and must never enter history, whatever the target;
#   • its target is an ABSOLUTE path (non-portable, dev-machine-specific);
#   • its target lexically ESCAPES the repository root (`../…` climbs out).
#
# Bypass (rare, e.g. an intentional in-repo relative symlink this heuristic
# can't distinguish): SYMLINK_GATE_OFF=1 git commit ...
if [ "${SYMLINK_GATE_OFF:-}" != "1" ]; then
  # True (0) if resolving $2 (a relative target) from directory $1 climbs above
  # the repo root — purely lexical, no realpath/filesystem dependency so it works
  # even when the target does not yet exist on this machine.
  symlink_escapes_repo() {
    local combined="$1/$2" depth=0 comp
    local old_ifs="$IFS"
    IFS='/'
    for comp in $combined; do
      case "$comp" in
        '' | .) : ;;
        ..)
          depth=$((depth - 1))
          if [ "$depth" -lt 0 ]; then IFS="$old_ifs"; return 0; fi
          ;;
        *) depth=$((depth + 1)) ;;
      esac
    done
    IFS="$old_ifs"
    return 1
  }

  while IFS= read -r linkpath; do
    [ -n "$linkpath" ] || continue
    target=$(git show ":$linkpath" 2>/dev/null || true)
    base=$(basename "$linkpath")
    reason=""
    if [ "$base" = "node_modules" ]; then
      reason="a 'node_modules' symlink must never be committed (shared hoisted deps are machine-local)"
    elif [ "${target#/}" != "$target" ]; then
      reason="its target '$target' is an absolute path (non-portable / dev-machine-specific)"
    elif symlink_escapes_repo "$(dirname "$linkpath")" "$target"; then
      reason="its target '$target' escapes the repository root"
    fi
    if [ -n "$reason" ]; then
      echo "✖ symlink gate (#913): refusing staged symlink '$linkpath' — $reason." >&2
      echo "  Unstage it (git rm --cached '$linkpath') and use a real, in-repo relative link if you truly need one." >&2
      echo "  Override (rare, intentional in-repo relative symlink): SYMLINK_GATE_OFF=1 git commit ..." >&2
      fail=1
    fi
  done < <(git diff --cached --raw --diff-filter=AMT | awk -F'\t' '{ n = split($1, a, " "); if (a[2] == "120000") print $2 }')
fi

# ── validate gate: frontmatter + dangling-ref + DR-index integrity ───────────
# `npm run validate` (validate-frontmatter.ts) scans the WHOLE artifact corpus:
# docs/decisions/ (DR sequence + #220 INDEX-status drift), specs/ (frontmatter +
# epic refs), docs/domain/, docs/epics/, AND the #161 dangling-reference checker
# over specs/ + docs/decisions/.
#
# The trigger was originally scoped to the #220 DR/INDEX gate only (DR/INDEX
# staged). But the validators that ride the same invocation scan FILES THEY,
# not the DR-index gate, own — a dangling ref or bad frontmatter introduced in a
# spec (or domain/epic doc) was never caught locally, only in CI (#316). Widen
# the trigger to every directory the validator scans, so all of its gates fire at
# commit, not only on a push. Keep the existing DR/INDEX trigger as a subset.
# Bypass: DR_INDEX_GATE_OFF=1 git commit ...
#
# ── Pre-existing vs INTRODUCED (#1471) ────────────────────────────────────────
# The validator scans the whole corpus, so while main is red for ANY reason every
# commit here is blocked — including one that touches none of the failing files.
# Worse, the failure is MISATTRIBUTED: you are told your commit failed validation
# and handed a filename you never opened. That happened on 2026-08-12: a two-line
# DR status flip was blocked by SPEC-055/SPEC-057 missing `implements:`, and the
# gate's own text pointed at DR-index drift, which was not the cause at all.
#
# So when the corpus is red, ask the second question before blaming the commit:
# was this ALREADY broken at HEAD? Only violations the commit INTRODUCES are its
# fault. CI keeps the corpus-wide view, which is the right scope there.
#
# Cost is paid only on the failure path — a passing commit still runs the
# validator exactly once.
#
# The baseline is built with `git archive` into a temp dir rather than a second
# worktree: the hook runs while git holds the index lock, and this touches no git
# state at all — it just materialises HEAD's files and reads them.
_validate_fail_lines() { grep -E '^FAIL ' || true; }

_validate_head_baseline() {
  # Prints HEAD's FAIL lines. Exits non-zero if the baseline cannot be built —
  # the caller then FAILS CLOSED rather than assuming "pre-existing".
  local tmp
  tmp="$(mktemp -d 2>/dev/null)" || return 1
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" RETURN
  git archive HEAD 2>/dev/null | tar -x -C "$tmp" 2>/dev/null || return 1
  [ -f "$tmp/scripts/validate-frontmatter.ts" ] || return 1
  # The validator needs deps; reuse this checkout's rather than installing.
  [ -d node_modules ] && ln -s "$PWD/node_modules" "$tmp/node_modules" 2>/dev/null

  # A RED baseline is the normal case here — the validator exiting non-zero is
  # the signal, not an error — so swallow its status deliberately. `|| true` on
  # the capture, NOT on the pipeline: under `set -o pipefail` (line 24) piping a
  # failing validator into grep propagates its status, so the first version of
  # this returned non-zero on every red baseline and the whole comparison was
  # inert, silently falling back to fail-closed. It looked like it worked.
  local out
  out="$( cd "$tmp" && npm run --silent validate 2>&1 )" || true

  # Witness that the validator actually RAN. Absent its summary line, an empty
  # FAIL set means "could not run", not "clean" — and treating that as a clean
  # baseline would mark every pre-existing failure as introduced.
  case "$out" in
    *"validation error(s)"*|*"validation passed"*) ;;
    *) return 1 ;;
  esac

  printf '%s\n' "$out" | _validate_fail_lines
  return 0
}

if [ "${DR_INDEX_GATE_OFF:-}" != "1" ] && \
   git diff --cached --name-only | grep -qE '^(docs/decisions/(DR-[0-9].*|INDEX)\.md|specs/.*\.md|docs/domain/.*\.md|docs/epics/.*\.md)$'; then
  if ! validate_out="$(npm run --silent validate 2>&1)"; then
    printf '%s\n' "$validate_out" >&2

    # Witness that THIS run's validator actually ran, before reading anything into
    # its (possibly empty) FAIL set. The baseline path has always done this; the
    # live path did not, and the asymmetry failed OPEN: a validator that exits
    # non-zero without emitting FAIL lines — a crash, a broken dep, an unhandled
    # rejection, or a syntax error introduced by this very commit — produced an
    # empty `now_fails`, hence an empty `introduced`, hence "nothing introduced,
    # allowed". Strictly worse than the behaviour this replaced, which blocked.
    # Caught in review on #1483. Same rule, both paths, no exceptions.
    case "$validate_out" in
      *"validation error(s)"*|*"validation passed"*) ;;
      *)
        echo "" >&2
        echo "✖ validate gate: the validator exited non-zero without reporting a result." >&2
        echo "  No summary line, so its FAIL set cannot be trusted as complete — this is a" >&2
        echo "  broken validator, not a clean commit. Failing closed (#1483 review)." >&2
        echo "  Override: DR_INDEX_GATE_OFF=1 git commit ..." >&2
        fail=1
        exit $fail
        ;;
    esac

    now_fails="$(printf '%s\n' "$validate_out" | _validate_fail_lines)"
    if base_fails="$(_validate_head_baseline)"; then
      introduced="$(comm -13 <(printf '%s\n' "$base_fails" | sort -u) <(printf '%s\n' "$now_fails" | sort -u))"
    else
      introduced="$now_fails"
      echo "⚠ could not build the HEAD baseline — treating every failure as introduced (fail-closed)." >&2
    fi

    if [ -z "$(printf '%s' "$introduced" | tr -d '[:space:]')" ]; then
      echo "" >&2
      echo "ℹ validate gate: the corpus is red, but NONE of it was introduced by this commit —" >&2
      echo "  every failure above already exists at HEAD. Allowing the commit (#1471)." >&2
      echo "  Someone needs to fix main; it is not you, and it is not this change." >&2
    else
      echo "" >&2
      echo "✖ validate gate: this commit INTRODUCES the following:" >&2
      printf '%s\n' "$introduced" | sed 's/^/    /' >&2
      echo "  For DR-index status drift, regenerate the DR INDEX" >&2
      echo "  (MinSpec: Regenerate DR INDEX) so INDEX.md matches the DR frontmatter." >&2
      echo "  Override: DR_INDEX_GATE_OFF=1 git commit ..." >&2
      fail=1
    fi
  fi
fi

exit $fail
