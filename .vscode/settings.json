{
    "cSpell.words": [
        "Approvable",
        "Approvables",
        "clinerules",
        "cursorrules",
        "Frontmatter",
        "minspec",
        "WSJF"
    ],
    "minspec.autoClassifyOnCommit": true,

    // Offer to push each approval as soon as it is committed, so a sign-off cannot be
    // stranded on one machine (three duplicate recovery PRs were opened for the same
    // two records on 2026-07-27 — #1022). `main` is protected here, so a direct push
    // would be REJECTED: MinSpec instead pushes the same commit on an `approvals/…`
    // branch and offers the PR link.
    //
    // Deliberately "prompt", not "always", in the COMMITTED workspace file: this is a
    // shared repo, and committing "always" would opt every contributor into automatic
    // network egress on Alt+A without their per-action say-so. Standing consent is a
    // personal choice — set "always" in your own USER settings if you want it (DR-071).
    "minspec.pushOnApprove": "prompt",

    // Surface the stdlib-unittest hook tests (scripts/hooks/test_*.py) in the
    // Testing panel. These run canonical.py / the spec-gate as subprocesses and
    // are invisible to the Vitest and Extension Test Runner controllers.
    "python.testing.unittestEnabled": true,
    "python.testing.pytestEnabled": false,
    "python.testing.unittestArgs": ["-v", "-s", "scripts/hooks", "-p", "test_*.py"],

    // Deliberately NOT pinning python.defaultInterpreterPath here. It was set to
    // /usr/bin/python3, which is a Linux-only absolute path in a git-tracked file in
    // a public repo — wrong on Windows and on Homebrew macOS. It is only a first-run
    // fallback, and these are stdlib-only unittest files with no venv and no
    // requirements.txt, so the extension's own interpreter discovery is sufficient.
    // Pin it in your USER settings if your machine needs it.

    // node:test suite (.github/scripts/*.test.js) — the ai-review label-integrity
    // logic. Plain `node --test`, no deps, so neither Vitest nor the Python
    // controller sees it; atkeson.nodejs-testing does.
    //
    // ".github" in the include list is what makes it visible AT ALL. The extension
    // builds its file matcher with picomatch and does not pass `dot: true`, and
    // picomatch's "**/" will not traverse a leading-dot path SEGMENT — so under the
    // default include of ["./"] this suite is undiscoverable and the panel just
    // shows nothing. `include` REPLACES the default, so "./" must stay listed.
    // (A leading-dot BASENAME is fine; only a dot DIRECTORY blocks it.)
    //
    // THESE KEYS ARE INERT WHEN THIS REPO IS OPENED VIA minspecpro.code-workspace.
    // The extension declares no `scope` on its properties, so VS Code registers them
    // as WINDOW scope and a multi-root FolderConfiguration drops them; separately,
    // the extension reads them with no resource argument, so a folder value would
    // never be consulted regardless. They are kept here for opening this repo ALONE,
    // where folder settings are the workspace configuration. The multi-root copy
    // lives in the .code-workspace `settings` block and must be kept in step.
    //
    // Verified by scripts/check-testing-panel-discovery.mjs, which replays the
    // extension's own glob algorithm against BOTH copies — this file (as a bare
    // folder open) and the .code-workspace block (as a multi-root open) — and fails
    // when an expected suite would not appear under either. Run it after touching
    // either copy.
    "nodejs-testing.include": ["./", ".github"],
    "nodejs-testing.exclude": [
        // Restated because setting `exclude` REPLACES the extension's default rather
        // than merging with it — dropping this would re-admit node_modules.
        "**/node_modules/**",
        // packages/minspec/out/test/*.test.js are compiled extension-host tests that
        // fail under plain node ("Cannot find module 'vscode'"). They are NOT a live
        // false-red source: they import mocha, not node:test, and the extension's own
        // source pre-check discards any file lacking the specifier it imports. This
        // entry saves a few file reads and states the intent; it is not a bug fix.
        "**/out/**"
    ]
}