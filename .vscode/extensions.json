{
  // Extensions that make the Testing panel show ALL of this repo's automated-test
  // systems, not just the Vitest unit suite:
  //   - vitest.explorer        → packages/*/tests/**/*.test.ts   (Vitest)
  //   - ms-python.python       → scripts/hooks/test_*.py         (stdlib unittest)
  //   - atkeson.nodejs-testing → .github/scripts/*.test.js       (node:test)
  //
  // Deliberately no case counts here: a hardcoded total in a comment goes stale the
  // first time anyone adds a test, and a stale count reads as authoritative. The
  // globs are the durable statement. For live numbers: scripts/test-all.sh
  //
  // NOT listed: ms-vscode.extension-test-runner, which drives the mocha
  // extension-host suite (packages/minspec/src/test/** via .vscode-test.mjs).
  // It is a Microsoft-licensed extension published only to the VS Code
  // Marketplace — https://open-vsx.org/api/ms-vscode/extension-test-runner
  // returns "Extension not found", so recommending it to a VSCodium/OSS user
  // produces an install prompt that cannot succeed. On Microsoft-branded VS Code
  // it installs normally and is worth adding to your USER-level recommendations.
  //
  // Either way that suite still runs headless from the CLI:
  //   npm run test:e2e --workspace=minspec
  "recommendations": [
    "vitest.explorer",
    "ms-python.python",
    "atkeson.nodejs-testing"
  ]
}
