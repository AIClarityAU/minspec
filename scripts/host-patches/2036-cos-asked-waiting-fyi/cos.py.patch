+def human_ask(txt):
+    """(asking, items) - does ONE assistant turn hold anything for a HUMAN? (#2036)
+
+    `items` is [(actor, why, segment)] for every arrow item, each classified by
+    item_actor() - the same parser cmd_nudge dispatches on, so the display
+    surfaces (asked, waiting) and the relay path can never disagree about what an
+    item is. `asking` is True when ANY item resolves to "human".
+
+    Fails closed, toward the human and never toward "fyi" (property 1 above):
+      - an unmarked, unknown, malformed or vetoed item resolves to "human"
+        inside item_actor(), so it is an ask;
+      - a turn that carries an arrow or "Your turn" but no readable item
+        (pending_items() is None) is an ask with items == [] - it cannot be
+        classified, so it is shown, exactly as it was before the marker existed.
+    Only a block whose every item is explicitly [fyi] or [act] is not an ask.
+    A turn with no arrow and no "Your turn" is (False, []).
+    """
+    if not txt:
+        return (False, [])
+    segs = pending_items(txt)
+    if segs is None:
+        return ((ARROW in txt or "Your turn" in txt), [])
+    items = [item_actor(s) + (s,) for s in segs]
+    return (any(actor == "human" for actor, _why, _seg in items), items)
+
+
+def item_tally(items):
+    """'2 act, 1 fyi' style count of classified (actor, why, segment) items."""
+    n = {}
+    for actor, _why, _seg in items:
+        n[actor] = n.get(actor, 0) + 1
+    label = {"agent": "act"}
+    return ", ".join(f"{n[a]} {label.get(a, a)}" for a in ("human", "agent", "fyi") if a in n)
+
+
