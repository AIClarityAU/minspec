+def nudge_text(r):
+    """(text, why) for one session, as cmd_nudge must see it.
+
+    Exactly one of the two is non-empty. `why` is the reason the session could NOT
+    be classified as parked-or-not. It exists because "" used to mean both "nothing
+    to nudge" and "I could not tell", and cmd_nudge skipped on it, so a session
+    wedged mid-tool-call - whose last record is by definition a USER record, the
+    tool result - vanished from the output and a run made only of such sessions
+    printed "no parked sessions" (#2093). An unclassifiable session is a third
+    state, never an absent one.
+    """
+    if not r.get("tpath"):
+        return ("", "no transcript found for this session")
+    kind, txt = last_turn(r["tpath"])
+    if kind == "none":
+        return ("", "transcript has no readable user/assistant record")
+    if kind == "user":
+        return ("", "last record is a USER record (tool result or unanswered prompt), "
+                    "not an assistant stop - wedged mid-tool-call?")
+    if not txt:
+        return ("", "last assistant record has no text - it ended on a tool call")
+    return (txt, "")
+
+
