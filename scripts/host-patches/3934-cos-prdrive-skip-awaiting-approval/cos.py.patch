+def prdrive_human_cap(hcands, tries, recorded):
+    """Pure: (kept, capped) for the BEHIND human-turn rows, in their given order (#3934).
+
+    Under strict an update to a PR waiting on the founder is thrown away by the next merge to
+    main, so one such PR must not keep the single update slot: measured, #3690 (awaiting-approval,
+    no recorded act) took ~6 updates in 48h. A row with PRDRIVE_PRIORITY_MAX_TRIES or more recent
+    attempts and no recorded founder act is capped: not updated again until the attempts age out
+    of the window, so rows with fewer attempts take the slot first. A recorded act is never
+    capped (the approval is on the branch; updating it is the last step before the founder's
+    merge). Runner-mergeable (DR-112) rows are not in `hcands`: they went to `cands` earlier and
+    are never touched by this."""
+    kept = [n for n in hcands if recorded.get(n) or tries.get(n, 0) < PRDRIVE_PRIORITY_MAX_TRIES]
+    return kept, [n for n in hcands if n not in kept]
+
