+# Ceiling on an "every open PR" read. It was a literal `--limit 40` repeated at six call
+# sites, sized when the open count sat well under 40. Measured 2026-10-01: 79 open, so
+# `adminable --verbose` printed exactly 40 rows and the 39 OLDEST PRs (gh lists newest
+# first) were never examined by any producer - and nothing said so (minspec #2369).
+# gh pages 100 at a time under one invocation, so a high ceiling costs one extra API
+# call per 100 open PRs, not one per PR.
+OPEN_PR_LIMIT = 500
+
+
+class OpenPrListFailed(OSError):
+    """`gh pr list` exited non-zero, so the open set was NOT read.
+
+    Subclasses OSError so every caller's existing fail-closed handler catches it. The
+    alternative - handing back [] - is how a failed read used to print "nothing to hand
+    over" and "every open PR is ready for the human": a claim about a queue nobody read.
+    """
+
+
+def open_prs(repo, fields):
+    """(prs, truncated) - every open PR in `repo`, or proof that the read was cut short.
+
+    The ONE place an open-PR list is fetched. Six producers each carried their own
+    `gh pr list --limit 40` and none compared what came back against the limit, so a
+    truncated read was indistinguishable from a complete one.
+
+    Asks for one row MORE than the ceiling. Getting it back is proof that more exist,
+    rather than the guess `len == limit` would be (which also fires on an exactly-full
+    queue). The probe row is dropped: `truncated` is the signal, never a longer list.
+
+    Callers MUST act on `truncated`: print truncated_line() and exit non-zero, and never
+    print a whole-queue claim ("none qualify", "nothing to hand over") beside it.
+    """
+    raw = subprocess.run(
+        ["gh", "pr", "list", "--repo", repo, "--state", "open",
+         "--limit", str(OPEN_PR_LIMIT + 1), "--json", fields],
+        env=gh_env(repo), capture_output=True, text=True, timeout=90)
+    if raw.returncode != 0:
+        raise OpenPrListFailed(" ".join((raw.stderr or "").split())[:120]
+                               or f"gh pr list exited {raw.returncode}")
+    prs = json.loads(raw.stdout or "[]")
+    if len(prs) > OPEN_PR_LIMIT:
+        return prs[:OPEN_PR_LIMIT], True
+    return prs, False
+
+
+def truncated_line(repo, shown, consequence):
+    """The one line every producer prints when open_prs() was cut short."""
+    return (f"TRUNCATED: showing {shown}, more exist - {repo} has over {OPEN_PR_LIMIT} "
+            f"open PRs and the rest were NOT examined; {consequence} "
+            f"(raise OPEN_PR_LIMIT in cos.py)")
+
+
